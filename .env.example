# SmartBasket Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# APPLICATION
# ============================================
APP_NAME=SmartBasket
APP_ENV=development
APP_PORT=8080
APP_SECRET=change-me-to-a-long-random-string

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartbasket
DB_USER=smartbasket
DB_PASSWORD=your-db-password-here
DB_SSL=false

# ============================================
# CACHE (Redis)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
REDIS_DB=0
REDIS_TTL=3600

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRY=86400000
JWT_REFRESH_EXPIRY=604800000

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# FRONTEND (Vite)
# ============================================
VITE_API_URL=http://localhost:8080/api
VITE_APP_NAME=SmartBasket
VITE_APP_ENV=development

# ============================================
# AI / OPENAI (for AI assistant features)
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# ============================================
# EMAIL (optional — for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@smartbasket.ai
SMTP_PASSWORD=your-smtp-app-password
EMAIL_FROM=SmartBasket <noreply@smartbasket.ai>

# ============================================
# STORAGE (optional — for product images)
# ============================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# AWS S3 (if using cloud storage)
AWS_REGION=us-east-1
AWS_BUCKET=smartbasket-assets
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key

# ============================================
# STRIPE (optional — for payments)
# ============================================
STRIPE_PUBLIC_KEY=pk_test_your-key-here
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-key-here

# ============================================
# MONITORING (optional)
# ============================================
SENTRY_DSN=
LOG_LEVEL=info
